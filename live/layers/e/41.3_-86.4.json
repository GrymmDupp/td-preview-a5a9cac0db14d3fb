{"v":"202611211841","e":{"o:w89507045":{"d":"cemetery in Marshall County, Indiana, United States","bu":[["Florence Riddick Boys","American writer"]],"bn":2,"lk":[["Wikidata","https://www.wikidata.org/wiki/Q117630304"],["Commons category","https://commons.wikimedia.org/wiki/Category:Oak_Hill_Cemetery_%28Plymouth%2C_Ind%29"]]},"o:w587728933":{"d":"cemetery in Marshall County, Indiana, United States","lk":[["Wikidata","https://www.wikidata.org/wiki/Q117526349"]]},"n:12000338":{"pv":1,"d":"historic house in Indiana, United States","f":[["Listed","Jun 15, 2012"],["Significance","Architecture; Commerce"],["Level","Local"],["Category","Building"],["Address","1715 Lake Ave., Plymouth"]],"lk":[["Nomination file (National Archives)","https://catalog.archives.gov/id/132004134"],["Wikidata","https://www.wikidata.org/wiki/Q5877446"]],"ph":{"u":"https://upload.wikimedia.org/wikipedia/commons/1/10/Hoham-Klinghammer-Weckerle_House_and_Brewery_Site_east_side.jpg","l":"https://commons.wikimedia.org/wiki/File:Hoham-Klinghammer-Weckerle_House_and_Brewery_Site_east_side.jpg","a":"Asporner","lic":"CC BY-SA 3.0","licu":"https://creativecommons.org/licenses/by-sa/3.0","src":"Wikimedia Commons","alt":"Hoham-Klinghammer-Weckerle House and Brewery Site east side"},"wx":["The Hoham-Klinghammer-Weckerle House and Brewery Site, located in Plymouth, Indiana is connected to three German families, all related through marriage, that settled in the area in 1844–1865. The Hoham, Klinghammer, and Weckerle families established and operated the Plymouth Brewery from 1857 to 1888.","https://en.wikipedia.org/wiki/Hoham-Klinghammer-Weckerle_House_and_Brewery_Site"]},"n:81000001":{"pv":0,"f":[["Listed","Jul 23, 1981"],["Significance","Transportation"],["Level","Local"],["Category","Site"],["Address","Spans Yellow River, Plymouth"]],"lk":[["Nomination file (National Archives)","https://catalog.archives.gov/id/132004126"],["Wikidata","https://www.wikidata.org/wiki/Q25006768"]],"ph":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/East_Laporte_Street_Footbridge.jpg/960px-East_Laporte_Street_Footbridge.jpg","l":"https://commons.wikimedia.org/wiki/File:East_Laporte_Street_Footbridge.jpg","a":"Nyttend","lic":"Public domain","licu":"","src":"Wikimedia Commons","alt":"East Laporte Street Footbridge"},"wx":["East LaPorte Street Footbridge is a historic footbridge located at Plymouth, Indiana. It was built in 1898 by the Rochester Bridge Company and spans the Yellow River.","https://en.wikipedia.org/wiki/East_LaPorte_Street_Footbridge"]},"n:81000002":{"pv":1,"d":"historic fire station in Plymouth, Marshall County, Indiana, United States","f":[["Listed","Jul 9, 1981"],["Significance","Politics/Government; Architecture"],["Level","Local"],["Category","Building"],["Address","220 N. Center St., Plymouth"]],"lk":[["Nomination file (National Archives)","https://catalog.archives.gov/id/132004144"],["Wikidata","https://www.wikidata.org/wiki/Q25006749"]],"ph":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Plymouth_IN_Firestation.JPG/960px-Plymouth_IN_Firestation.JPG","l":"https://commons.wikimedia.org/wiki/File:Plymouth_IN_Firestation.JPG","a":"Smallbones","lic":"CC0","licu":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","src":"Wikimedia Commons","alt":"Plymouth IN Firestation"},"wx":["Plymouth Fire Station is a historic fire station located at Plymouth, Indiana. It was built in 1875, and is a two-story, painted brick building with a 59-foot tall bell tower.","https://en.wikipedia.org/wiki/Plymouth_Fire_Station"]},"n:83000139":{"pv":1,"d":"courthouse in Plymouth, Indiana, United States of America","f":[["Listed","Jun 30, 1983"],["Significance","Politics/Government; Architecture"],["Level","Local"],["Category","Building"],["Address","117 W. Jefferson St., Plymouth"],["Style","Renaissance Revival architecture"]],"lk":[["Nomination file (National Archives)","https://catalog.archives.gov/id/132004138"],["Wikidata","https://www.wikidata.org/wiki/Q25208358"]],"ph":{"u":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Plymouth-indiana-courthouse.jpg/960px-Plymouth-indiana-courthouse.jpg","l":"https://commons.wikimedia.org/wiki/File:Plymouth-indiana-courthouse.jpg","a":"See file page","lic":"Public domain","licu":"","src":"Wikimedia Commons","alt":"Plymouth-indiana-courthouse"},"wx":["Marshall County Courthouse is a historic courthouse located at Plymouth, Indiana. It was built between 1870 and 1872, and is a two-story, brick and limestone building in a combination of Italianate and Renaissance Revival styles.","https://en.wikipedia.org/wiki/Marshall_County_Courthouse_(Indiana)"]},"o:w1132330546":{"d":"cemetery in Marshall County, Indiana, United States","f":[["Religion","Christian"]],"lk":[["Wikidata","https://www.wikidata.org/wiki/Q117618325"]]}}}